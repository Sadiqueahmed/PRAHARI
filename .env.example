# ====================================================================
# Project Prahari — Environment Variables
# ====================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ====================================================================

# === Database (PostgreSQL + PostGIS) ===
POSTGRES_DB=prahari
POSTGRES_USER=prahari_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# === PgAdmin ===
PGADMIN_EMAIL=admin@prahari.dev
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# === Spring Boot ===
# Generate a 64-char hex secret: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_CHAR_HEX_SECRET_KEY_FOR_PRODUCTION_DEPLOYMENT
JWT_EXPIRATION_MS=86400000
# 86400000ms = 24 hours

# === Mapbox GL JS ===
# Get your token at: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=YOUR_MAPBOX_ACCESS_TOKEN_HERE

# === WhatsApp Business Cloud API ===
# Configure at: https://developers.facebook.com/apps/
WHATSAPP_PHONE_NUMBER_ID=YOUR_META_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=YOUR_META_ACCESS_TOKEN
WHATSAPP_VERIFY_TOKEN=YOUR_WEBHOOK_VERIFY_TOKEN
WHATSAPP_API_VERSION=v21.0

# === Twilio (International SMS Fallback) ===
# Configure at: https://console.twilio.com/
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_TOKEN
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# === Fast2SMS (India SMS Fallback) ===
# Configure at: https://www.fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY

# === AQICN (Air Quality) ===
# Get your token at: https://aqicn.org/data-platform/token/
AQICN_API_TOKEN=YOUR_AQICN_TOKEN

# === NWDP / CWC (River Level Data) ===
# Register at: https://nwdp.nwic.gov.in
NWDP_API_KEY=YOUR_NWDP_KEY_IF_REQUIRED

# === Application URLs ===
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080
